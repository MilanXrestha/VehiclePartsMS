{
  "info": {
    "name": "VehiclePartsMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:5147" },
    { "key": "vendorId", "value": "" },
    { "key": "partId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "customerProfileId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "appointmentId", "value": "" },
    { "key": "partRequestId", "value": "" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Vendors",
      "item": [
        {
          "name": "Create Vendor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('vendorId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/vendors",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AutoParts Co.\",\n  \"phone\": \"9800000001\",\n  \"email\": \"autoparts@example.com\",\n  \"address\": \"123 Parts Street, Kathmandu\"\n}"
            }
          }
        },
        {
          "name": "Get All Vendors",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/vendors"
          }
        },
        {
          "name": "Get Vendor by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/vendors/{{vendorId}}"
          }
        },
        {
          "name": "Update Vendor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/vendors/{{vendorId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"AutoParts Co. Updated\",\n  \"phone\": \"9800000002\",\n  \"email\": \"updated@example.com\",\n  \"address\": \"456 New Street, Kathmandu\"\n}"
            }
          }
        },
        {
          "name": "Delete Vendor",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/vendors/{{vendorId}}"
          }
        }
      ]
    },
    {
      "name": "2. Parts",
      "item": [
        {
          "name": "Create Part",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('partId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/parts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brake Pad\",\n  \"description\": \"High-performance ceramic brake pad\",\n  \"category\": \"Brakes\",\n  \"price\": 2500.00,\n  \"stockQuantity\": 50,\n  \"vendorId\": {{vendorId}}\n}"
            }
          }
        },
        {
          "name": "Get All Parts",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/parts"
          }
        },
        {
          "name": "Get Parts by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/parts?category=Brakes",
              "host": ["{{base}}"],
              "path": ["api", "parts"],
              "query": [{ "key": "category", "value": "Brakes" }]
            }
          }
        },
        {
          "name": "Get Part by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/parts/{{partId}}"
          }
        },
        {
          "name": "Update Part",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/parts/{{partId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brake Pad Pro\",\n  \"description\": \"Premium ceramic brake pad\",\n  \"category\": \"Brakes\",\n  \"price\": 2800.00,\n  \"stockQuantity\": 45,\n  \"vendorId\": {{vendorId}}\n}"
            }
          }
        },
        {
          "name": "Delete Part",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/parts/{{partId}}"
          }
        }
      ]
    },
    {
      "name": "3. Users (Staff)",
      "item": [
        {
          "name": "Create Staff User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('staffId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ram\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"ram.sharma@vehicleparts.com\",\n  \"phone\": \"9800000010\",\n  \"password\": \"Staff@123\",\n  \"role\": 1\n}"
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/users"
          }
        },
        {
          "name": "Get Staff Only",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/users/staff"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/users/{{staffId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/users/{{staffId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ram\",\n  \"lastName\": \"Sharma\",\n  \"phone\": \"9800000011\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{base}}/api/users/{{staffId}}"
          }
        }
      ]
    },
    {
      "name": "4. Customers",
      "item": [
        {
          "name": "Register Customer (with Vehicle)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('customerId', res.userId);",
                  "pm.collectionVariables.set('customerProfileId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sita\",\n  \"lastName\": \"Thapa\",\n  \"email\": \"sita.thapa@gmail.com\",\n  \"phone\": \"9800000020\",\n  \"password\": \"Customer@123\",\n  \"address\": \"Lalitpur, Nepal\",\n  \"vehicle\": {\n    \"vehicleNumber\": \"BA 1 KHA 1234\",\n    \"make\": \"Toyota\",\n    \"model\": \"Hilux\",\n    \"year\": 2020\n  }\n}"
            }
          }
        },
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/customers"
          }
        },
        {
          "name": "Search by Name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/customers?name=Sita",
              "host": ["{{base}}"],
              "path": ["api", "customers"],
              "query": [{ "key": "name", "value": "Sita" }]
            }
          }
        },
        {
          "name": "Search by Phone",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/customers?phone=9800000020",
              "host": ["{{base}}"],
              "path": ["api", "customers"],
              "query": [{ "key": "phone", "value": "9800000020" }]
            }
          }
        },
        {
          "name": "Search by Vehicle Number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base}}/api/customers?vehicleNumber=BA 1 KHA 1234",
              "host": ["{{base}}"],
              "path": ["api", "customers"],
              "query": [{ "key": "vehicleNumber", "value": "BA 1 KHA 1234" }]
            }
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/customers/{{customerProfileId}}"
          }
        },
        {
          "name": "Get Customer History",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/customers/{{customerProfileId}}/history"
          }
        },
        {
          "name": "Add Vehicle to Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/customers/{{customerProfileId}}/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleNumber\": \"BA 2 JA 5678\",\n  \"make\": \"Honda\",\n  \"model\": \"CR-V\",\n  \"year\": 2022\n}"
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/customers/{{customerProfileId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Bhaktapur, Nepal\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Sales Invoices",
      "item": [
        {
          "name": "Create Invoice (triggers loyalty discount if > 5000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('invoiceId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/salesinvoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerProfileId\": {{customerProfileId}},\n  \"staffId\": {{staffId}},\n  \"paymentStatus\": 0,\n  \"items\": [\n    {\n      \"partId\": {{partId}},\n      \"quantity\": 3\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get All Invoices",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/salesinvoices"
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/salesinvoices/{{invoiceId}}"
          }
        },
        {
          "name": "Get Invoices by Customer",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/salesinvoices/customer/{{customerProfileId}}"
          }
        }
      ]
    },
    {
      "name": "6. Appointments",
      "item": [
        {
          "name": "Create Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('appointmentId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerProfileId\": {{customerProfileId}},\n  \"appointmentDate\": \"2026-05-15T10:00:00\",\n  \"notes\": \"Oil change and brake inspection\"\n}"
            }
          }
        },
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/appointments"
          }
        },
        {
          "name": "Get Appointment by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/appointments/{{appointmentId}}"
          }
        },
        {
          "name": "Get Appointments by Customer",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/appointments/customer/{{customerProfileId}}"
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/appointments/{{appointmentId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "7. Part Requests",
      "item": [
        {
          "name": "Create Part Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('partRequestId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/partrequests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerProfileId\": {{customerProfileId}},\n  \"partName\": \"Shock Absorber\",\n  \"description\": \"Looking for front shock absorber for Toyota Hilux 2020\"\n}"
            }
          }
        },
        {
          "name": "Get All Part Requests",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/partrequests"
          }
        },
        {
          "name": "Get Part Request by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/partrequests/{{partRequestId}}"
          }
        },
        {
          "name": "Get Part Requests by Customer",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/partrequests/customer/{{customerProfileId}}"
          }
        },
        {
          "name": "Update Part Request Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/partrequests/{{partRequestId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 1\n}"
            }
          }
        }
      ]
    },
    {
      "name": "8. Reviews",
      "item": [
        {
          "name": "Create Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('reviewId', res.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base}}/api/reviews",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerProfileId\": {{customerProfileId}},\n  \"rating\": 5,\n  \"comment\": \"Excellent service and quality parts!\"\n}"
            }
          }
        },
        {
          "name": "Get All Reviews",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/reviews"
          }
        },
        {
          "name": "Get Reviews by Customer",
          "request": {
            "method": "GET",
            "url": "{{base}}/api/reviews/customer/{{customerProfileId}}"
          }
        }
      ]
    }
  ]
}
